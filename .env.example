# Copy to .env. Every setting is documented in docs/deployment.md.

LocalLogin__SigningKey=
# Required. Generate with: openssl rand -base64 32

Postgres__Password=luckymaze
# Postgres__User=luckymaze
# Postgres__Database=luckymaze
# ConnectionStrings__LuckyMazeDatabase=

# LuckyMaze__Port=8080

# The frontend is served by the API itself, same origin - this only matters if you're running
# `ng serve` against a deployed API instead of the bundled deployment.
# Cors__AllowedOrigins__0=http://localhost:4200

# A future real identity provider, alongside local login - see docs/dev_setup.md.
# Oidc__Authority=
# Oidc__ClientId=luckymaze

# Only read with compose.hardware.yml, on the Pi the Pico and Klipper actually run on:
# Hardware__PicoPort=/dev/ttyACM0
# Hardware__KlippySocketPath=/home/lucky-user/printer_data/comms/klippy.sock
# Hardware__DialoutGroupId=20
# Hardware__CellSizeMm=30.0

# Movement tuning - all optional, sent as plain G-code so there's nothing to redeploy to retune.
# Hardware__StepFeedRateMmPerMin=2400
# Hardware__TravelFeedRateMmPerMin=3000
# Unset by default - leaves Klipper's own printer.cfg acceleration limit in effect. Set this to
# override it via M204 instead of editing printer.cfg on the Pi.
# Hardware__AccelerationMmPerSec2=
