# Copy to .env. Every setting is documented in docs/deployment.md.

LocalLogin__SigningKey=
# Required. Generate with: openssl rand -base64 32

Postgres__Password=luckymaze
# Postgres__User=luckymaze
# Postgres__Database=luckymaze
# ConnectionStrings__LuckyMazeDatabase=

# LuckyMaze__Port=8080

# The frontend is served by the API itself, same origin - this only matters if you're running
# `ng serve` against a deployed API instead of the bundled deployment.
# Cors__AllowedOrigins__0=http://localhost:4200

# A future real identity provider, alongside local login - see docs/dev_setup.md.
# Oidc__Authority=
# Oidc__ClientId=luckymaze

# Only read with compose.hardware.yml, on the Pi the Pico and Klipper actually run on:
# Hardware__PicoPort=/dev/ttyACM0
# Hardware__KlippySocketPath=/home/lucky-user/printer_data/comms/klippy.sock
# Hardware__DialoutGroupId=20
# klippy.sock is owned by whoever runs Klipper and their own primary group, not dialout - confirm
# with `id <that-user>` (the "gid=" number). Get this wrong and every G-code send fails with
# "Permission denied" - the panel and betting still work, only the carriage silently never moves.
# Hardware__KlipperGroupId=1000

# The panel's own pixel pitch (mm between LED centers) - 3.0 for a Waveshare P3 64x64. The
# carriage's target is derived from this and the same raster pixel the LED dot is shown at, so the
# magnet always tracks directly under the visible ball. Change this only if the panel isn't a P3.
# Hardware__PixelPitchMm=3.0

# There are no endstops on this rig, so "origin" is wherever the carriage was hand-parked before
# SET_KINEMATIC_POSITION zeroes it. If that spot isn't exactly under the panel's own top-left
# pixel, nudge it here (mm) rather than re-parking the carriage by hand.
# Hardware__OriginOffsetXMm=0.0
# Hardware__OriginOffsetYMm=0.0

# If the carriage moves the opposite direction from what the panel shows on one or both axes
# (depends on this rig's CoreXY mounting/wiring - there's no way to know it in advance), flip the
# matching one here rather than rewiring or touching printer.cfg.
# Hardware__InvertX=false
# Hardware__InvertY=false

# Movement tuning - all optional, sent as plain G-code so there's nothing to redeploy to retune.
# Hardware__StepFeedRateMmPerMin=2400
# Hardware__TravelFeedRateMmPerMin=3000
# Unset by default - leaves Klipper's own printer.cfg acceleration limit in effect. Set this to
# override it via M204 instead of editing printer.cfg on the Pi.
# Hardware__AccelerationMmPerSec2=
